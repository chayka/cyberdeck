# Waveshare's own demo code — fetched on demand by ups/fetch-vendor.sh, not
# redistributed here (their license, not ours).
ups/vendor/

# Hailo sources and firmware are large and version-specific; hailo/fetch-sources.sh
# retrieves them. dkms-stage/ works around an upstream Makefile path bug — see
# hailo/setup.sh.
hailo/build/
hailo/src/
hailo/dkms-stage/
*.hef

# HailoRT drops a log next to wherever it is run from.
hailort.log

__pycache__/
*.py[cod]

# Per-peripheral virtualenvs (see PLAN.md — created with --system-site-packages).
.venv/


# Kernel module build artifacts (ups/driver). The source and the DKMS recipe are
# tracked; the objects are rebuilt per kernel by DKMS.
*.ko
*.o
*.mod
*.mod.c
*.dtbo
.*.cmd
Module.symvers
modules.order
